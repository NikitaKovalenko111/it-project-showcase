{
  "name": "uust-it-project-showcase-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,js,jsx,mjs,cjs}\" vite.config.ts",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,js,jsx,mjs,cjs}\" vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:integration": "vite --mode integration"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "@uiw/react-md-editor": "^4.2.3",
    "axios": "^1.7.9",
    "canvas-confetti": "^1.9.3",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.29.0",
    "redux": "^5.0.1",
    "redux-saga": "^1.3.0",
    "rehype-sanitize": "^6.0.0",
    "sass": "^1.85.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.6.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
